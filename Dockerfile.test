# syntax=docker/dockerfile:1
# The spec (JUnit): the EPA examples run in the real engine, their .out read with EPA's reader.
#   docker build -f Dockerfile.test -t swmm-cli-test . && docker run --rm swmm-cli-test
#   ./spec.sh [--debug] [Class#method]   (this src/ mounted; --debug waits for a debugger on localhost:5005)
FROM debian:bookworm-slim AS swmm
ARG SWMM_VERSION=v5.2.4
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch ${SWMM_VERSION} https://github.com/USEPA/Stormwater-Management-Model.git /src \
    && cmake -S /src -B /build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build --target swmm5 swmm-output -j \
    && cp "$(find /build -name 'libswmm5.so' | head -1)" /libswmm5.so \
    && cp "$(find /build -name 'libswmm-output.so' | head -1)" /libswmm-output.so

FROM scratch AS jextract-amd64
ADD --checksum=sha256:d0cc481abc1adb16fb9514e1c5e0bfc08d38c29228bece667fb5054ceaffaa42 \
    https://download.java.net/java/early_access/jextract/25/2/openjdk-25-jextract+2-4_linux-x64_bin.tar.gz /jextract.tar.gz

FROM scratch AS jextract-arm64
ADD --checksum=sha256:0e25e6f6efa042f8758eaec65a873887fd2247fcf2e3e22dcfd7e4179fc8b0ae \
    https://download.java.net/java/early_access/jextract/25/2/openjdk-25-jextract+2-4_linux-aarch64_bin.tar.gz /jextract.tar.gz

FROM jextract-${TARGETARCH} AS jextract

FROM maven:3.9-eclipse-temurin-25
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY --from=jextract /jextract.tar.gz /tmp/
COPY --from=swmm /src/src/solver/include/swmm5.h /tmp/
COPY --from=swmm /src/src/outfile/include /tmp/outfile/
RUN tar xzf /tmp/jextract.tar.gz -C /opt \
    && /opt/jextract-25/bin/jextract --output target/generated-sources/jextract --target-package swmm4j.ffi \
       --header-class-name swmm5 /tmp/swmm5.h \
    && /opt/jextract-25/bin/jextract --output target/generated-sources/jextract --target-package swmm4j.out \
       --header-class-name swmm_output -I /tmp/outfile /tmp/outfile/swmm_output.h
COPY --from=swmm /libswmm5.so /libswmm-output.so /opt/swmm/
ENV SWMM_LIB=/opt/swmm/libswmm5.so SWMM_OUTPUT_LIB=/opt/swmm/libswmm-output.so
COPY pom.xml ./
COPY src src
COPY examples examples
# compiles the code and the spec (most of what the test phase needs is then in the image)
RUN mvn -B -q test-compile
# TEST: a class or a method (SwmmOutputTest#json); DEBUG=1: the tests' JVM waits for a debugger on 5005
COPY --chmod=755 <<'SPEC' /usr/local/bin/spec
#!/bin/sh
set -e
set -- mvn -B test -Dsurefire.failIfNoSpecifiedTests=false
[ -n "$TEST" ] && set -- "$@" "-Dtest=$TEST"
[ -n "$DEBUG" ] && set -- "$@" "-Dmaven.surefire.debug=-agentlib:jdwp=transport=dt_socket,server=y,suspend=y,address=*:5005"
exec "$@"
SPEC
ENV TEST="" DEBUG=""
EXPOSE 5005
CMD ["spec"]
